# ── Shopify Storefront API ───────────────────────────────────────────────
# Shopify admin → Settings → Apps and sales channels → Develop apps →
# create an app with Storefront API access, then copy the public token.
# These are NEXT_PUBLIC_ because the Storefront API token is designed for
# client-side use (it can only read products and manage carts).
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=[your-store.myshopify.com]
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=[storefront-access-token]

# ── Sanity CMS ───────────────────────────────────────────────────────────
# sanity.io/manage → your project → the ID is in the URL and on the dashboard.
# Leave these unset and the site still builds and renders — every page falls
# back to the copy committed in the components.
NEXT_PUBLIC_SANITY_PROJECT_ID=[sanity-project-id]
NEXT_PUBLIC_SANITY_DATASET=production

# Server-side only — required for draft-mode preview / visual editing.
# sanity.io/manage → API → Tokens → create a token with Viewer permissions.
# Never prefix with NEXT_PUBLIC_: it can read unpublished drafts.
SANITY_API_READ_TOKEN=[sanity-read-token]

# ── Newsletter ───────────────────────────────────────────────────────────
# Pick a provider (mailchimp | klaviyo | convertkit | buttondown), implement
# its call in app/api/newsletter/route.ts, then set these. Server-side only —
# never prefix with NEXT_PUBLIC_.
NEWSLETTER_PROVIDER=[provider-name]
NEWSLETTER_API_KEY=[api-key]
