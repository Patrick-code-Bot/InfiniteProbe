# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Repo root. The Next.js app lives in site/ and keeps its own .gitignore;
# the patterns here are rooted at the project root, so app-level paths are
# spelled out relative to site/.

# dependencies
/site/node_modules
/site/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/site/coverage

# next.js
/site/.next/
/site/out/

# production
/site/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — real secrets never tracked; the template is
.env*.local
.env*
!site/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
